# Copy to .env if you want to change the database location. Optional: this is the default.
DATABASE_URL="file:./dev.db"

# Secret used to sign login cookies. Optional for local demos (a built-in fallback is used); set your own value anywhere else.
# SESSION_SECRET="change-me-to-a-long-random-string"

# Site assistant (chat bubble, bottom right). Get a key in Google AI Studio and put it in your own .env (never commit it).
# Without a key the assistant shows "not available" and the rest of the site works as usual.
# GEMINI_API_KEY="your-key-here"
# Optional: which Gemini model to use (default gemini-3.5-flash). Google closes old models to new API keys; change it here if one stops working.
# GEMINI_MODEL="gemini-3.5-flash"
