// InfluenceIt data model (SQLite).
// Prices are stored as a whole number + a currency code (never as formatted text).
// Role and order status are plain strings; their allowed values live in lib/orderStatus.js.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           Int      @id @default(autoincrement())
  role         String // "BRAND" or "CREATOR"
  name         String
  // Login fields. Seed accounts get the shared demo password (see prisma/seed.mjs).
  email        String?  @unique
  passwordHash String?
  createdAt    DateTime @default(now())

  creatorProfile CreatorProfile?
  brandProfile   BrandProfile?
  sentMessages   Message[]
}

model CreatorProfile {
  id              Int     @id @default(autoincrement())
  userId          Int     @unique
  slug            String  @unique
  handle          String
  niche           String
  city            String
  bio             String
  // Sign-up details. Lists are plain strings: ids separated by commas (categories) or file names separated by commas (galleryImages).
  gender          String?
  phone           String?
  categories      String  @default("")
  profileImage    String?
  galleryImages   String  @default("")
  followers       Int
  rating          Float
  completedOrders Int
  deliveryDays    Int
  verified        Boolean @default(false)
  avatarShape     String // "circle" | "arch" | "square"
  avatarBg        String
  avatarFg        String

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  packages       Package[]
  orders         Order[]
  applications   Application[]
  socialAccounts SocialAccount[]
  conversations  Conversation[]

  @@index([niche])
  @@index([city])
}

// One social media account of a creator. The follower count is typed in by the creator (not checked).
// CreatorProfile.followers is the sum over all of a creator's accounts.
model SocialAccount {
  id        Int      @id @default(autoincrement())
  creatorId Int
  platform  String // "instagram" | "tiktok" | "youtube" | "x" | "kick" (see lib/options.js PLATFORMS)
  username  String // without the leading @
  followers Int
  createdAt DateTime @default(now())

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, platform])
}

model BrandProfile {
  id             Int     @id @default(autoincrement())
  userId         Int     @unique
  companyName    String
  companyTitle   String?
  phone          String?
  industry       String
  budgetAmount   Int?
  budgetCurrency String  @default("TRY")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders        Order[]
  jobs          Job[]
  conversations Conversation[]
}

model Package {
  id            Int    @id @default(autoincrement())
  creatorId     Int
  name          String
  description   String
  priceAmount   Int
  priceCurrency String @default("TRY")
  deliveryDays  Int
  // Filled for packages made in the sign-up wizard: the platform, the contents as JSON ([{ "type", "count" }]),
  // the number of included revisions and how long the content stays online ("", "24h", "7d", "30d", "permanent").
  platform      String @default("")
  contents      String @default("")
  revisions     Int    @default(1)
  stay          String @default("")

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@index([creatorId])
}

model Order {
  id            Int       @id @default(autoincrement())
  brandId       Int
  creatorId     Int
  // A package order has a packageId. An order that starts from a chosen job applicant has a jobId instead.
  packageId     Int?
  jobId         Int?      @unique
  brief         String
  status        String    @default("PENDING") // see lib/orderStatus.js
  // Price is copied from the package at order time so later price edits do not change old orders.
  priceAmount   Int
  priceCurrency String    @default("TRY")
  deliveryLink  String?
  // Copy of the package name at order time (creators can rename packages later).
  packageName   String    @default("")
  deliveryNote  String? // creator's note with the delivery
  revisionNote  String? // brand's request when asking for changes
  deliveryVideo String? // stored file name in storage/uploads (see lib/storage.js)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  paidAt        DateTime?
  deliveredAt   DateTime?
  completedAt   DateTime?

  brand   BrandProfile   @relation(fields: [brandId], references: [id])
  creator CreatorProfile @relation(fields: [creatorId], references: [id])
  package Package?       @relation(fields: [packageId], references: [id])
  job     Job?           @relation(fields: [jobId], references: [id])

  @@index([brandId])
  @@index([creatorId])
  @@index([status])
}

// An open brief posted by a brand. Creators apply to it.
// Title and summary are stored in one language; the *Tr columns hold an optional Turkish copy.
model Job {
  id             Int      @id @default(autoincrement())
  brandId        Int
  title          String
  summary        String
  titleTr        String?
  summaryTr      String?
  niche          String
  format         String // key of jobs.formats in locales (for example "reelStories")
  budgetAmount   Int
  budgetCurrency String   @default("TRY")
  deliveryDays   Int
  status         String   @default("OPEN") // "OPEN" or "CLOSED"
  createdAt      DateTime @default(now())

  brand        BrandProfile  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  applications Application[]
  order        Order?

  @@index([brandId])
  @@index([status])
  @@index([niche])
}

model Application {
  id        Int      @id @default(autoincrement())
  jobId     Int
  creatorId Int
  message   String   @default("")
  status    String   @default("PENDING") // "PENDING", "ACCEPTED" or "REJECTED" (the brand decides)
  createdAt DateTime @default(now())

  job     Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([jobId, creatorId])
  @@index([creatorId])
}

// Messaging between a brand and a creator. One conversation per pair; either side can start it.
// updatedAt is set to the time of the newest message so the inbox can sort by it.
model Conversation {
  id        Int      @id @default(autoincrement())
  brandId   Int
  creatorId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  brand    BrandProfile   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  creator  CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([brandId, creatorId])
  @@index([updatedAt])
}

// One chat message. readAt is empty until the other side has opened the conversation.
model Message {
  id             Int       @id @default(autoincrement())
  conversationId Int
  senderId       Int
  body           String
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
